{
  "name": "2notes",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{js,ts,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{js,ts,json,md}\" \".github/**/*.yml\"",
    "audit:frontend": "node scripts/test/audit-frontend.mjs && node scripts/test/check-minimatch-brace.mjs",
    "check:minimatch": "node scripts/test/check-minimatch-brace.mjs",
    "audit:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test/cargo-audit-if-available.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.0.1",
    "@unocss/reset": "^66.7.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.62.0",
    "unocss": "^66.7.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  }
}
